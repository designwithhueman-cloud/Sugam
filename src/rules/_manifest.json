{
  "schemaVersion": 1,
  "library": "Avara Rule Library",
  "libraryVersion": "1.0.0-draft",
  "categories": [
    {
      "id": "product_clarity",
      "label": "Product Clarity",
      "code": "PC",
      "weight": 15,
      "file": "product-clarity.json",
      "userImpact": "Visitors who cannot tell what the product is or who it is for leave before they act.",
      "businessImpact": "Some visitors may not understand the offer, which can mean fewer sign-ups. This is a hypothesis; Avara did not measure your visitors."
    },
    {
      "id": "ux_workflow",
      "label": "UX & Workflow Quality",
      "code": "UX",
      "weight": 15,
      "file": "ux.json",
      "userImpact": "Visitors get stuck, lose their place or cannot tell what happened.",
      "businessImpact": "Friction in the main task can lower completion. This is a hypothesis; Avara did not measure completion."
    },
    {
      "id": "mobile",
      "label": "Mobile Responsiveness",
      "code": "MOB",
      "weight": 10,
      "file": "mobile.json",
      "userImpact": "People on phones cannot see or use parts of the page.",
      "businessImpact": "Phone visitors may be unable to complete the main action. This is a hypothesis; Avara did not measure conversions."
    },
    {
      "id": "accessibility",
      "label": "Accessibility",
      "code": "A11Y",
      "weight": 10,
      "file": "accessibility.json",
      "userImpact": "People who use assistive technology or a keyboard may be unable to use part of the page.",
      "businessImpact": "Excluded visitors cannot convert, and there may be legal exposure that Avara does not assess."
    },
    {
      "id": "trust",
      "label": "Trust & Credibility",
      "code": "TRUST",
      "weight": 10,
      "file": "trust.json",
      "userImpact": "Visitors who cannot verify who is behind the page hesitate to share details or pay.",
      "businessImpact": "Missing proof can lower willingness to commit. This is a hypothesis; absence alone is not a defect."
    },
    {
      "id": "design",
      "label": "Design & Brand Quality",
      "code": "DESIGN",
      "weight": 10,
      "file": "design.json",
      "userImpact": "Unclear hierarchy or inconsistent styling makes the page harder to read and scan.",
      "businessImpact": "Weak hierarchy can hide the main action. This is a hypothesis; Avara did not measure attention."
    },
    {
      "id": "conversion",
      "label": "Conversion Readiness",
      "code": "CONV",
      "weight": 15,
      "file": "conversion.json",
      "userImpact": "Unclear actions or heavy forms make it harder to take the next step.",
      "businessImpact": "Friction at the point of conversion can lower conversions. This is a hypothesis; Avara did not measure conversions."
    },
    {
      "id": "performance",
      "label": "Performance",
      "code": "PERF",
      "weight": 15,
      "file": "performance.json",
      "userImpact": "Slow or shifting pages frustrate visitors, especially on phones.",
      "businessImpact": "Slow loading can cost visitors before they see the page. This is a hypothesis; lab results are not field data."
    },
    {
      "id": "differentiation",
      "label": "Differentiation & Design Maturity",
      "code": "DIFF",
      "weight": 0,
      "file": "diff.json",
      "userImpact": "Visitors cannot tell this page from others that look the same.",
      "businessImpact": "A page that looks like a template makes the product feel interchangeable. This is a hypothesis; Avara did not measure it."
    }
  ],
