# Copy to deploy/production.env (never commit it) and fill in. docs/deploy.md explains each line.

# --- Your site ---
AVARA_DOMAIN=example.com
SUGAM_URL=https://example.com
AVARA_CONTACT_EMAIL=hello@example.com
# The person or company that runs the site, shown on the privacy page.
AVARA_OPERATOR=Your Name or Company

# --- Secrets: generate each with `openssl rand -hex 32` ---
POSTGRES_PASSWORD=
SUGAM_SECRET=

# --- AI (paid tier for real users; see docs/deploy.md) ---
AVARA_AI=on
AVARA_AI_PROVIDER=gemini
GEMINI_API_KEY=
AVARA_GEMINI_MODEL=gemini-3.5-flash
# Or Claude instead:
# AVARA_AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# --- Capacity and limits ---
SCAN_CONCURRENCY=2
ANON_SCAN_CEILING=60
ANON_RETENTION_DAYS=30

# --- Optional sign-in with Google / GitHub ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
